{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "regions": [
    "fra1"
  ],
  "crons": [
    {
      "path": "/api/bookings/cron?kind=digest",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/bookings/cron?kind=reminder",
      "schedule": "0 15 * * *"
    }
  ]
}
