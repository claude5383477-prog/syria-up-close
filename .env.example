# Copy to .env and fill in. Never commit .env.

# PostgreSQL. Local dev: `npm run db` starts an embedded server with these credentials.
# With docker compose this is ignored: the app connects to the "db" service built from POSTGRES_* below.
DATABASE_URL=postgres://syria:syria-local-dev@localhost:54329/syria_dev
# Neon only: the direct (non -pooler) string of the same branch, for migrations and the seed.
DATABASE_URL_UNPOOLED=

# Long random string (e.g. `openssl rand -hex 32`). Required in production. Also authorises
# POST /api/revalidate-site (container boot, `npm run revalidate`), so keep it secret.
PAYLOAD_SECRET=

# Public base URL, no trailing slash. Compiled into the image: rebuild after changing it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Seed accounts (npm run seed). Use strong passwords outside local dev.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_CORRESPONDENT_EMAIL=
SEED_CORRESPONDENT_PASSWORD=

# Image storage (src/lib/storage.ts): Vercel Blob when BLOB_READ_WRITE_TOKEN is set (production; Vercel
# adds it when a Blob store is connected), else S3/R2 when S3_BUCKET is set, else local disk (MEDIA_DIR).
# In the Docker image MEDIA_DIR is /data/media (a volume).
BLOB_READ_WRITE_TOKEN=
MEDIA_DIR=./media
S3_BUCKET=
S3_REGION=auto
# R2: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Empty: images are served through Payload (/api/media/file/...). Set to the bucket's public domain
# (e.g. https://media.example.org) and redeploy to serve them from R2 directly. No code change.
R2_PUBLIC_URL=

# docker compose only: the PostgreSQL service and the host port for the site.
POSTGRES_USER=syria
POSTGRES_PASSWORD=
POSTGRES_DB=syria
APP_PORT=3000

# Dev only: phone testing over the LAN. Set both, then: npm run dev -- -H 0.0.0.0
# NEXT_PUBLIC_SITE_URL=http://192.168.1.20:3000
# ALLOWED_DEV_ORIGINS=192.168.1.20
