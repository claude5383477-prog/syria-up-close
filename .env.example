# Copy to .env and fill in. Never commit .env.

# PostgreSQL. Local dev: `npm run db` starts an embedded server with these credentials.
DATABASE_URL=postgres://syria:syria-local-dev@localhost:54329/syria_dev

# Long random string (e.g. `openssl rand -hex 32`). Required in production.
PAYLOAD_SECRET=

# Public base URL, no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Seed accounts (npm run seed). Use strong passwords outside local dev.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_CORRESPONDENT_EMAIL=
SEED_CORRESPONDENT_PASSWORD=

# Image storage: local disk (MEDIA_DIR) unless S3_BUCKET is set (S3-compatible, e.g. Cloudflare R2).
MEDIA_DIR=./media
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
