{
  "name": "syria-up-close",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "db": "node scripts/db.mjs",
    "seed": "payload run src/seed/index.ts",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "build": "next build --webpack",
    "start": "payload migrate && next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:int": "vitest run --config vitest.int.config.ts",
    "test:e2e": "playwright test",
    "lhci": "node scripts/lhci.mjs",
    "fonts:subset": "node scripts/fonts/subset.mjs",
    "screens": "playwright test -c playwright.screens.config.ts && node scripts/compare.mjs",
    "check:guard": "node scripts/check-guard.mjs",
    "check:fast": "npm run typecheck && npm run lint && npm run check:guard",
    "check:task": "npm run check:fast && npm run test:coverage",
    "check:full": "npm run check:task && npm run test:int && npm run test:e2e",
    "revalidate": "node scripts/revalidate.mjs",
    "vercel-build": "node scripts/vercel-build.mjs",
    "seed:remote": "node scripts/seed-remote.mjs",
    "seed:content": "node scripts/seed-content.mjs",
    "photos:fill": "node scripts/photos-fill.mjs",
    "correspondent:create": "node scripts/create-correspondent.mjs",
    "check:prod": "playwright test -c playwright.prod.config.ts",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "backup:drill": "node scripts/backup-drill.mjs",
    "seo:audit": "tsx scripts/seo-audit.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/email-nodemailer": "3.91.0",
    "@payloadcms/email-resend": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/storage-s3": "3.91.0",
    "@payloadcms/storage-vercel-blob": "3.91.0",
    "@payloadcms/translations": "3.91.0",
    "@vercel/blob": "2.3.1",
    "graphql": "16.14.2",
    "html-to-image": "1.11.13",
    "jspdf": "4.2.1",
    "leaflet": "1.9.4",
    "next": "16.4.2",
    "payload": "3.91.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@ibm/plex-sans-arabic": "1.1.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@types/leaflet": "1.9.20",
    "@types/node": "24.19.2",
    "@types/pg": "8.20.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "pg": "8.20.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
