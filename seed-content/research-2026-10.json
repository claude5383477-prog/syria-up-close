  "editorNotes": [
    { "topic": "money", "note": "سعر المصرف المركزي 20 تشرين الأول 2026: نحو 122 ليرة جديدة للدولار؛ السوق 11 تشرين الأول: نحو 140. الأوراق القديمة فقدت صفتها القانونية في 31 تموز 2026. فئات الليرة الجديدة: 10، 25، 50، 100، 200، 500.", "sourceUrls": ["https://rahhal.wego.com/blog/%D8%B9%D9%85%D9%84%D8%A9-%D8%B3%D9%88%D8%B1%D9%8A%D8%A7-%D8%A7%D9%84%D8%AC%D8%AF%D9%8A%D8%AF%D8%A9-%D9%84%D9%84%D9%85%D8%B3%D8%A7%D9%81%D8%B1%D9%8A%D9%86/", "https://www.aljazeera.net/news/2026/10/11/%D8%A7%D9%84%D9%84%D9%8A%D8%B1%D8%A9-%D8%A7%D9%84%D8%B3%D9%88%D8%B1%D9%8A%D8%A9-%D8%AA%D9%87%D9%88%D9%8A-%D9%85%D8%AC%D8%AF%D8%AF%D8%A7-%D8%B3%D8%B9%D8%B1-%D8%A7%D9%84%D8%B5%D8%B1%D9%81"] },
